{
  "name": "setup-packer",
  "version": "3.0.1",
  "private": true,
  "license": "ISC",
  "author": "step-security",
  "scripts": {
    "build": "rm -rf dist && esbuild --bundle --format=cjs --outfile=dist/index.js --platform=node --target=node24 src/index.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "type-check": "tsc"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@actions/io": "3.0.2",
    "@actions/tool-cache": "4.0.0",
    "axios": "^1.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tsconfig/node24": "^24.0.0",
    "@tsconfig/strictest": "^2.0.5",
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.2"
  },
  "packageManager": "yarn@4.7.0"
}
